# HireMe Environment Configuration
# Copy this file to .env.local and adjust values for your setup
#
# ══════════════════════════════════════════════════════════════════════════════
# GENERAL
# ══════════════════════════════════════════════════════════════════════════════

# Application environment: development, staging, production
APP_ENV=development

# ══════════════════════════════════════════════════════════════════════════════
# API SERVER
# ══════════════════════════════════════════════════════════════════════════════

# Port for the Go API server
SERVER_PORT=8080

# Read/write timeouts in seconds
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30

# ══════════════════════════════════════════════════════════════════════════════
# DATABASE
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL connection URL
# Format: postgres://user:password@host:port/database?sslmode=disable
# NOTE: Using port 5433 to avoid conflicts with other local PostgreSQL instances.
# Production uses docker-compose.yml where containers communicate internally on 5432.
DATABASE_URL=postgres://hireme:hireme_dev_password@localhost:5433/hireme?sslmode=disable

# Maximum number of open connections
DB_MAX_CONNECTIONS=25

# Encryption key for sensitive fields (generate with: openssl rand -hex 32)
# Leave empty in development if not using field-level encryption
DB_ENCRYPTION_KEY=

# ══════════════════════════════════════════════════════════════════════════════
# AUTHENTICATION
# ══════════════════════════════════════════════════════════════════════════════

# --- DEVELOPMENT AUTH BYPASS ---
# Set to true to skip OIDC authentication (DEV ONLY!)
AUTH_BYPASS_ENABLED=true

# User ID to use when bypass is enabled
AUTH_BYPASS_USER_ID=dev-user-001

# --- JWT CONFIGURATION ---
# Secret for signing JWTs (generate with: openssl rand -hex 32)
JWT_SECRET=dev-jwt-secret-change-in-production

# Token expiration in hours
JWT_EXPIRATION_HOURS=24

# --- GOOGLE OIDC ---
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/callback/google

# ══════════════════════════════════════════════════════════════════════════════
# STORAGE
# ══════════════════════════════════════════════════════════════════════════════

# Storage backend: "local" or "r2"
STORAGE_BACKEND=local

# --- LOCAL STORAGE ---
# Path for local file storage (relative to project root or absolute)
STORAGE_LOCAL_PATH=./data/uploads

# --- CLOUDFLARE R2 (Production) ---
# Obtain from: https://dash.cloudflare.com/
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=hireme-assets
R2_PUBLIC_URL=

# ══════════════════════════════════════════════════════════════════════════════
# EXPORT SERVICE
# ══════════════════════════════════════════════════════════════════════════════

# Gotenberg URL for PDF/DOCX generation
GOTENBERG_URL=http://localhost:3001

# ══════════════════════════════════════════════════════════════════════════════
# LIMITS & QUOTAS
# ══════════════════════════════════════════════════════════════════════════════

# Maximum asset file size in bytes (default: 2MB)
MAX_ASSET_SIZE_BYTES=2097152

# Maximum image dimensions (width or height)
MAX_IMAGE_DIMENSION=2000

# Allowed image formats (comma-separated)
ALLOWED_IMAGE_FORMATS=image/jpeg,image/png,image/webp

# ══════════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ══════════════════════════════════════════════════════════════════════════════

# Enable/disable features
FEATURE_ADS=false
FEATURE_EXPORT_PDF=true
FEATURE_EXPORT_DOCX=true

# ══════════════════════════════════════════════════════════════════════════════
# LOGGING
# ══════════════════════════════════════════════════════════════════════════════

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# Log format: text, json
LOG_FORMAT=text

# ══════════════════════════════════════════════════════════════════════════════
# NEXT.JS FRONTEND
# ══════════════════════════════════════════════════════════════════════════════

# API URL for the frontend to call
NEXT_PUBLIC_API_URL=http://localhost:8080

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=dev-nextauth-secret-change-in-production
