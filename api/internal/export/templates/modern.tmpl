{{template "base" .}}

{{define "styles"}}
<style>
.modern-page { padding: 48px; }
.modern-sections > * + * { margin-top: 24px; }
.modern-personal h1 { font-size: 1.875em; font-weight: 700; letter-spacing: -0.025em; }
.modern-personal .job-title { font-size: 1.125em; margin-top: 4px; }
.modern-personal .contact { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 12px; font-size: 0.875em; }
.modern-personal .contact .pipe { margin-right: 4px; }
.modern-personal .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; font-size: 0.875em; text-decoration: underline; }
.modern-section-title {
  font-size: 1.125em; font-weight: 700; padding-left: 12px; margin-bottom: 16px;
}
.modern-timeline { position: relative; padding-left: 24px; }
.modern-timeline-line {
  position: absolute; left: 7px; top: 8px; bottom: 0; width: 2px;
}
.modern-timeline-entry { position: relative; margin-bottom: 16px; }
.modern-timeline-dot {
  position: absolute; left: -24px; top: 6px; width: 12px; height: 12px;
  border-radius: 50%; border: 2px solid; background: white;
}
.modern-entry-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
.modern-entry-header h3 { font-weight: 600; font-size: 0.875em; }
.modern-entry-header .date { font-size: 0.75em; }
.modern-entry-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 2px; }
.modern-entry-meta .company { font-size: 0.875em; }
.modern-entry-meta .location { font-size: 0.75em; }
.modern-entry .description { font-size: 0.875em; margin-top: 4px; line-height: 1.625; }
.modern-entry .highlights { margin-top: 4px; }
.modern-entry .highlights li {
  font-size: 0.875em; display: flex; align-items: flex-start; gap: 8px;
}
.modern-entry .highlights li .bullet {
  margin-top: 6px; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
}
.modern-edu-entry + .modern-edu-entry { margin-top: 12px; }
.modern-edu-header { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px; }
.modern-edu-header h3 { font-weight: 600; font-size: 0.875em; }
.modern-edu-header .date { font-size: 0.75em; }
.modern-edu-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 2px; }
.modern-edu-meta .institution { font-size: 0.875em; }
.modern-edu-meta .location { font-size: 0.75em; }
.modern-edu-grade { font-size: 0.75em; margin-top: 2px; }
.modern-edu-desc { font-size: 0.875em; margin-top: 4px; line-height: 1.625; }
.modern-skills-cat + .modern-skills-cat { margin-top: 12px; }
.modern-skills-cat h3 { font-size: 0.875em; font-weight: 500; margin-bottom: 6px; }
.modern-skills-pills { display: flex; flex-wrap: wrap; gap: 6px; }
.modern-skill-pill {
  display: inline-flex; align-items: center;
  padding: 2px 10px; border-radius: 9999px; font-size: 0.75em; font-weight: 500;
}
.modern-lang-entry { display: flex; align-items: center; gap: 12px; }
.modern-lang-entry + .modern-lang-entry { margin-top: 10px; }
.modern-lang-name { font-size: 0.875em; font-weight: 500; width: 112px; flex-shrink: 0; }
.modern-lang-bars { display: flex; gap: 4px; }
.modern-lang-bar { width: 24px; height: 8px; border-radius: 2px; }
.modern-lang-level { font-size: 0.75em; text-transform: capitalize; }
</style>
{{end}}

{{define "content"}}
<div class="modern-page">
<div class="modern-sections">
{{range .Sections}}
  {{if eq .Type "personal"}}
    {{with .Personal}}
    <div class="modern-personal">
      {{if .FullName}}<h1>{{.FullName}}</h1>{{end}}
      {{if .Content.JobTitle}}<p class="job-title" style="color: {{$.Styling.PrimaryColor}}">{{.Content.JobTitle}}</p>{{end}}
      {{if .ContactParts}}
      <div class="contact" style="color: {{$.Styling.SecondaryColor}}">
        {{range $i, $p := .ContactParts}}{{if $i}}<span class="pipe">|</span>{{end}}<span>{{$p}}</span>{{end}}
      </div>
      {{end}}
      {{if .Content.Links}}
      <div class="links" style="color: {{$.Styling.SecondaryColor}}">
        {{range .Content.Links}}<span>{{linkLabel .}}</span>{{end}}
      </div>
      {{end}}
    </div>
    {{end}}
  {{else if eq .Type "summary"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      {{with .Summary}}<p class="description" style="font-size: 0.875em; line-height: 1.625; color: {{$.Styling.SecondaryColor}}">{{.Text}}</p>{{end}}
    </div>
  {{else if eq .Type "experience"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      <div class="modern-timeline">
        <div class="modern-timeline-line" style="background-color: {{$.Styling.PrimaryColor}}30"></div>
        {{with .Experience}}{{range .Entries}}
        <div class="modern-timeline-entry modern-entry">
          <div class="modern-timeline-dot" style="border-color: {{$.Styling.PrimaryColor}}"></div>
          <div class="modern-entry-header">
            <h3>{{.Position}}</h3>
            {{with dateRange .StartDate .EndDate .Current}}<span class="date" style="color: {{$.Styling.SecondaryColor}}">{{.}}</span>{{end}}
          </div>
          <div class="modern-entry-meta">
            <span class="company" style="color: {{$.Styling.PrimaryColor}}">{{.Company}}</span>
            {{if .Location}}<span class="location" style="color: {{$.Styling.SecondaryColor}}">| {{.Location}}</span>{{end}}
          </div>
          {{if .Description}}<p class="description" style="color: {{$.Styling.SecondaryColor}}">{{.Description}}</p>{{end}}
          {{if .Highlights}}
          <ul class="highlights">{{range .Highlights}}
            <li style="color: {{$.Styling.SecondaryColor}}"><span class="bullet" style="background-color: {{$.Styling.PrimaryColor}}"></span>{{.}}</li>
          {{end}}</ul>
          {{end}}
        </div>
        {{end}}{{end}}
      </div>
    </div>
  {{else if eq .Type "education"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      {{with .Education}}{{range .Entries}}
      <div class="modern-edu-entry">
        <div class="modern-edu-header">
          <h3>{{degreeField .Degree .Field}}</h3>
          {{with dateRange .StartDate .EndDate .Current}}<span class="date" style="color: {{$.Styling.SecondaryColor}}">{{.}}</span>{{end}}
        </div>
        <div class="modern-edu-meta">
          <span class="institution" style="color: {{$.Styling.PrimaryColor}}">{{.Institution}}</span>
          {{if .Location}}<span class="location" style="color: {{$.Styling.SecondaryColor}}">| {{.Location}}</span>{{end}}
        </div>
        {{if .Grade}}<p class="modern-edu-grade" style="color: {{$.Styling.SecondaryColor}}">Grade: {{.Grade}}</p>{{end}}
        {{if .Description}}<p class="modern-edu-desc" style="color: {{$.Styling.SecondaryColor}}">{{.Description}}</p>{{end}}
      </div>
      {{end}}{{end}}
    </div>
  {{else if eq .Type "skills"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      {{with .Skills}}{{range .Categories}}
      <div class="modern-skills-cat">
        {{if .Name}}<h3>{{.Name}}</h3>{{end}}
        <div class="modern-skills-pills">
          {{range .Skills}}<span class="modern-skill-pill" style="background-color: {{$.Styling.PrimaryColor}}15; color: {{$.Styling.PrimaryColor}}">{{.Name}}</span>{{end}}
        </div>
      </div>
      {{end}}{{end}}
    </div>
  {{else if eq .Type "languages"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      {{with .Languages}}{{range .Entries}}
      <div class="modern-lang-entry">
        <span class="modern-lang-name">{{.Language}}</span>
        <div class="modern-lang-bars">
          {{range proficiencyBars .Proficiency $.Styling.PrimaryColor}}<div class="modern-lang-bar" style="background-color: {{.}}"></div>{{end}}
        </div>
        <span class="modern-lang-level" style="color: {{$.Styling.SecondaryColor}}">{{.Proficiency}}</span>
      </div>
      {{end}}{{end}}
    </div>
  {{else if eq .Type "certifications"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      {{with .Certifications}}{{range .Entries}}
      <div style="margin-bottom: 12px;">
        <div class="modern-entry-header">
          <h3 style="font-weight: 600; font-size: 0.875em;">{{.Name}}</h3>
          {{if .Date}}<span class="date" style="font-size: 0.75em; color: {{$.Styling.SecondaryColor}}">{{certDateRange .Date .ExpiryDate}}</span>{{end}}
        </div>
        {{if .Issuer}}<p style="font-size: 0.875em; color: {{$.Styling.PrimaryColor}}; margin-top: 2px;">{{.Issuer}}</p>{{end}}
        {{if .CredentialID}}<p style="font-size: 0.75em; color: {{$.Styling.SecondaryColor}}; margin-top: 2px;">ID: {{.CredentialID}}</p>{{end}}
        {{if .URL}}<a href="{{.URL}}" style="font-size: 0.75em; color: {{$.Styling.PrimaryColor}}; text-decoration: underline;">Verify</a>{{end}}
      </div>
      {{end}}{{end}}
    </div>
  {{else if eq .Type "projects"}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      <div class="modern-timeline">
        <div class="modern-timeline-line" style="background-color: {{$.Styling.PrimaryColor}}30"></div>
        {{with .Projects}}{{range .Entries}}
        <div class="modern-timeline-entry modern-entry">
          <div class="modern-timeline-dot" style="border-color: {{$.Styling.PrimaryColor}}"></div>
          <div class="modern-entry-header">
            <h3>{{.Name}}</h3>
            {{with dateRange .StartDate .EndDate false}}<span class="date" style="color: {{$.Styling.SecondaryColor}}">{{.}}</span>{{end}}
          </div>
          {{if .Role}}<p style="font-size: 0.875em; color: {{$.Styling.PrimaryColor}}; margin-top: 2px;">{{.Role}}</p>{{end}}
          {{if .Description}}<p class="description" style="color: {{$.Styling.SecondaryColor}}">{{.Description}}</p>{{end}}
          {{if .Technologies}}
          <div class="modern-skills-pills" style="margin-top: 6px;">
            {{range .Technologies}}<span class="modern-skill-pill" style="background-color: {{$.Styling.PrimaryColor}}15; color: {{$.Styling.PrimaryColor}}">{{.}}</span>{{end}}
          </div>
          {{end}}
          {{if .URL}}<a href="{{.URL}}" style="font-size: 0.75em; color: {{$.Styling.PrimaryColor}}; text-decoration: underline; display: inline-block; margin-top: 4px;">View project</a>{{end}}
        </div>
        {{end}}{{end}}
      </div>
    </div>
  {{else}}
    <div>
      <h2 class="modern-section-title" style="border-left: 3px solid {{$.Styling.PrimaryColor}}">{{.Title}}</h2>
      <p style="font-size: 0.875em; color: {{$.Styling.SecondaryColor}}">{{.Type}} section</p>
    </div>
  {{end}}
{{end}}
</div>
</div>
{{end}}
