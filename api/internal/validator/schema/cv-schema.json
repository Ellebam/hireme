{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hireme.io/schemas/cv/1.0.0",
  "title": "CV Schema",
  "description": "Schema for HireMe CV documents",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Version of the CV schema"
    },
    "templateId": {
      "type": "string",
      "enum": ["classic", "modern", "visionary"],
      "description": "Base template for rendering"
    },
    "locale": {
      "type": "string",
      "enum": ["en", "de"],
      "default": "en",
      "description": "Document language"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "User-friendly name for this CV"
    },
    "sections": {
      "type": "array",
      "description": "Ordered list of CV sections",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "styling": {
      "$ref": "#/$defs/styling"
    }
  },
  "required": ["schemaVersion", "templateId", "sections"],
  "additionalProperties": false,

  "$defs": {
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "description": "Unique identifier for the section"
        },
        "type": {
          "type": "string",
          "enum": [
            "personal",
            "summary",
            "experience",
            "education",
            "skills",
            "languages",
            "certifications",
            "projects",
            "awards",
            "publications",
            "references",
            "custom"
          ],
          "description": "Type of section"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "description": "Display order (0 = first)"
        },
        "visible": {
          "type": "boolean",
          "default": true,
          "description": "Whether section is visible in export"
        },
        "title": {
          "type": "string",
          "maxLength": 100,
          "description": "Custom section title (optional, uses type label if not set)"
        },
        "content": {
          "type": "object",
          "description": "Section-specific content (validated by type-conditional allOf below)"
        }
      },
      "required": ["id", "type", "order", "content"],
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "personal" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/personalContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "summary" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/summaryContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "experience" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/experienceContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "education" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/educationContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "skills" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/skillsContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "languages" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/languagesContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "certifications" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/certificationsContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "projects" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/projectsContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "awards" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/awardsContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "publications" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/publicationsContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "references" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/referencesContent" } } }
        },
        {
          "if": { "properties": { "type": { "const": "custom" } }, "required": ["type"] },
          "then": { "properties": { "content": { "$ref": "#/$defs/customContent" } } }
        }
      ]
    },

    "personalContent": {
      "type": "object",
      "properties": {
        "firstName": { "type": "string", "maxLength": 50 },
        "lastName": { "type": "string", "maxLength": 50 },
        "jobTitle": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string", "maxLength": 30 },
        "location": { "type": "string", "maxLength": 100 },
        "portraitAssetId": { 
          "type": ["string", "null"],
          "description": "Reference to uploaded portrait image"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["linkedin", "github", "twitter", "website", "portfolio", "other"]
              },
              "url": { "type": "string", "format": "uri" },
              "label": { "type": "string", "maxLength": 50 }
            },
            "required": ["type", "url"],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "additionalProperties": false
    },

    "summaryContent": {
      "type": "object",
      "properties": {
        "text": { 
          "type": "string", 
          "maxLength": 2000,
          "description": "Professional summary or objective"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    },

    "experienceContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "company": { "type": "string", "maxLength": 100 },
              "position": { "type": "string", "maxLength": 100 },
              "location": { "type": "string", "maxLength": 100 },
              "startDate": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "description": "Format: YYYY-MM"
              },
              "endDate": { 
                "type": ["string", "null"],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
                "description": "Format: YYYY-MM, null if current"
              },
              "current": { "type": "boolean", "default": false },
              "description": { "type": "string", "maxLength": 3000 },
              "highlights": {
                "type": "array",
                "items": { "type": "string", "maxLength": 500 },
                "maxItems": 10
              }
            },
            "required": ["id", "company", "position", "startDate"],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "educationContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "institution": { "type": "string", "maxLength": 100 },
              "degree": { "type": "string", "maxLength": 100 },
              "field": { "type": "string", "maxLength": 100 },
              "location": { "type": "string", "maxLength": 100 },
              "startDate": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "endDate": { 
                "type": ["string", "null"],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "current": { "type": "boolean", "default": false },
              "grade": { "type": "string", "maxLength": 50 },
              "description": { "type": "string", "maxLength": 1000 }
            },
            "required": ["id", "institution", "degree"],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "skillsContent": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "maxLength": 50 },
              "skills": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string", "maxLength": 50 },
                    "level": {
                      "type": "string",
                      "enum": ["beginner", "intermediate", "advanced", "expert"],
                      "description": "Proficiency level (optional)"
                    }
                  },
                  "required": ["name"],
                  "additionalProperties": false
                },
                "maxItems": 20
              }
            },
            "required": ["id", "name", "skills"],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": ["categories"],
      "additionalProperties": false
    },

    "languagesContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "language": { "type": "string", "maxLength": 50 },
              "proficiency": {
                "type": "string",
                "enum": ["native", "fluent", "advanced", "intermediate", "basic"]
              },
              "certification": { "type": "string", "maxLength": 100 }
            },
            "required": ["id", "language", "proficiency"],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "certificationsContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "maxLength": 100 },
              "issuer": { "type": "string", "maxLength": 100 },
              "date": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "expiryDate": { 
                "type": ["string", "null"],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "credentialId": { "type": "string", "maxLength": 100 },
              "url": { "type": "string", "format": "uri" }
            },
            "required": ["id", "name", "issuer"],
            "additionalProperties": false
          },
          "maxItems": 20
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "projectsContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "maxLength": 100 },
              "role": { "type": "string", "maxLength": 100 },
              "description": { "type": "string", "maxLength": 2000 },
              "url": { "type": "string", "format": "uri" },
              "technologies": {
                "type": "array",
                "items": { "type": "string", "maxLength": 50 },
                "maxItems": 15
              },
              "startDate": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "endDate": { 
                "type": ["string", "null"],
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              }
            },
            "required": ["id", "name", "description"],
            "additionalProperties": false
          },
          "maxItems": 15
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "awardsContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "title": { "type": "string", "maxLength": 100 },
              "issuer": { "type": "string", "maxLength": 100 },
              "date": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "description": { "type": "string", "maxLength": 500 }
            },
            "required": ["id", "title"],
            "additionalProperties": false
          },
          "maxItems": 10
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "publicationsContent": {
      "type": "object",
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "title": { "type": "string", "maxLength": 200 },
              "publisher": { "type": "string", "maxLength": 100 },
              "date": { 
                "type": "string", 
                "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
              },
              "url": { "type": "string", "format": "uri" },
              "description": { "type": "string", "maxLength": 500 }
            },
            "required": ["id", "title"],
            "additionalProperties": false
          },
          "maxItems": 15
        }
      },
      "required": ["entries"],
      "additionalProperties": false
    },

    "referencesContent": {
      "type": "object",
      "properties": {
        "available": { 
          "type": "boolean", 
          "default": true,
          "description": "Show 'Available upon request' if no entries"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "format": "uuid" },
              "name": { "type": "string", "maxLength": 100 },
              "position": { "type": "string", "maxLength": 100 },
              "company": { "type": "string", "maxLength": 100 },
              "email": { "type": "string", "format": "email" },
              "phone": { "type": "string", "maxLength": 30 },
              "relationship": { "type": "string", "maxLength": 100 }
            },
            "required": ["id", "name"],
            "additionalProperties": false
          },
          "maxItems": 5
        }
      },
      "additionalProperties": false
    },

    "customContent": {
      "type": "object",
      "properties": {
        "markdown": { 
          "type": "string", 
          "maxLength": 5000,
          "description": "Markdown content for custom sections"
        }
      },
      "required": ["markdown"],
      "additionalProperties": false
    },

    "styling": {
      "type": "object",
      "properties": {
        "primaryColor": { 
          "type": "string", 
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#2563eb",
          "description": "Primary accent color (hex)"
        },
        "secondaryColor": { 
          "type": "string", 
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "default": "#64748b"
        },
        "fontFamily": { 
          "type": "string", 
          "enum": ["inter", "roboto", "opensans", "lato", "merriweather"],
          "default": "inter"
        },
        "fontSize": { 
          "type": "string", 
          "enum": ["small", "medium", "large"],
          "default": "medium"
        },
        "lineHeight": {
          "type": "string",
          "enum": ["compact", "normal", "relaxed"],
          "default": "normal"
        },
        "showIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show icons next to contact info"
        }
      },
      "additionalProperties": false
    }
  }
}
